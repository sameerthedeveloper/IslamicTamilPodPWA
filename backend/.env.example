# Database
DATABASE_URL=postgresql://app:apppass@localhost:5432/tamil_audio

# Redis (cache + BullMQ queue)
REDIS_URL=redis://localhost:6379

# Object storage — MinIO locally, Cloudflare R2 in production.
# Same client works against both; only these values change.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=audio-files
STORAGE_REGION=auto
# Legacy aliases still read as a fallback if STORAGE_* is unset:
# MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET, MINIO_REGION

# JWT
JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list of allowed origins. Unset + NODE_ENV=development
# falls back to "*"; unset in any other environment means "block everything".
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Environment
NODE_ENV=development

# App
APP_PORT=3000
APP_VERSION=1.0.0-alpha
